{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [
      "Serilog.Enrichers.ClientInfo",
      "Serilog.Sinks.File"
    ],
    "Enrich": [
      "WithClientIp"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {ClientIp}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "JobDatabase": "Server=(localdb)\\mssqllocaldb;Database=JobDatabase;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "PluginDirectory": "Plugins",
  "PluginSecurity": {
    "RequireDigitalSignature": false,
    "MaxAssemblySizeBytes": 10485760,
    "AllowedExtensions": [ ".dll" ]
  },
  "PluginCache": {
    "EnableInstanceCaching": true,
    "PoolSize": 10
  },
  "PluginResilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "ResetTimeoutSeconds": 30,
      "HalfOpenTestTimeoutSeconds": 10
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "InitialDelayMs": 100,
      "MaxDelaySeconds": 30,
      "BackoffMultiplier": 2.0
    }
  }
}
